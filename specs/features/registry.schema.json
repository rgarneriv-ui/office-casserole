{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-casserole/feature-record",
  "title": "Office Casserole feature registry record (spec §23.1)",
  "type": "object",
  "required": [
    "id", "application", "name", "priority", "description",
    "baseline", "owner", "acceptance", "verification", "status", "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$" },
    "application": { "type": "string" },
    "name": { "type": "string" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "description": { "type": "string", "description": "Observable user behavior" },
    "baseline": {
      "type": "object",
      "required": ["product", "capability", "verificationStatus"],
      "properties": {
        "product": { "type": "string" },
        "capability": { "type": "string" },
        "referenceDate": { "type": "string" },
        "verificationStatus": { "enum": ["confirmed", "inferred", "proposed"] }
      }
    },
    "owner": { "type": "string", "description": "Owning component/service (§3.1 single canonical owner)" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "array", "items": { "type": "string" } },
    "offlineSupport": { "type": "string" },
    "edgeCases": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "verification": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "enum": ["unit", "integration", "end-to-end", "accessibility", "compatibility", "security", "performance"] }
        }
      }
    },
    "status": {
      "enum": ["specified", "implemented", "tested", "verified", "released"],
      "description": "§22.4: may not advance to verified on the implementing agent's own assertion"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["test-run", "fixture", "report", "screenshot", "artifact"] },
          "ref": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "knownLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
